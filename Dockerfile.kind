# Runtime rapido para deploy local Kind (JAR ja compilado no host).
FROM eclipse-temurin:21-jre

WORKDIR /work

RUN useradd -r -u 1001 -g root -d /work -s /sbin/nologin appuser \
    && chown -R 1001:0 /work

COPY docker-dist/app.jar /work/app.jar
RUN chown 1001:0 /work/app.jar

USER 1001

EXPOSE 8080

ENV JAVA_OPTS="-XX:MaxRAMPercentage=75.0"

CMD ["sh", "-c", "java $JAVA_OPTS -jar /work/app.jar"]
